# ===== DEPLOYMENT ENVIRONMENT =====
NODE_ENV=production

# ===== DATABASE =====
# PostgreSQL connection to oute-mind VM
DATABASE_URL=postgresql://app-user:CHANGE_THIS@postgres:5432/oute_main

# ===== SERVICE AUTHENTICATION =====
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_KEY

# ===== INTER-SERVICE URLs =====
# These use Docker service names for internal communication
AUTH_SERVICE_URL=http://01_auth-profile:3001
PROJECTS_SERVICE_URL=http://02_projects:3002

# ===== OPTIONAL: Analytics/Logging =====
# LOG_LEVEL=info
# SENTRY_DSN=
