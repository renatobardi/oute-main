// =============================================================================
// OUTE Platform - Database Schema (DBML)
// =============================================================================
// Version:  1.0.0
// Database: PostgreSQL 15
// PKs:      UUID v7 (time-ordered)
// Audit:    created_at, updated_at, deleted_at on every table
// Date:     2026-03-10
// =============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

Enum user_role {
  owner
  admin
  member
  viewer
}

Enum project_status {
  draft
  active
  archived
}

Enum project_type {
  greenfield
  brownfield
}

Enum interview_status {
  scheduled
  in_progress
  completed
  cancelled
}

Enum message_sender {
  user
  ai
  system
}

Enum message_type {
  text
  code
  image
}

Enum milestone_tracking_status {
  pending
  in_progress
  completed
  skipped
  needs_revisit
  not_applicable
}

Enum estimation_session_status {
  draft
  in_progress
  completed
  abandoned
}

Enum integration_provider {
  linear
  jira
  asana
  github
  gitlab
}

Enum export_status {
  pending
  in_progress
  completed
  failed
}

Enum reviewer_verdict {
  confirmed_skip
  must_revisit
  not_needed
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 1: Identity & Access (IAM)
// ─────────────────────────────────────────────────────────────────────────────

TableGroup iam {
  users
  organizations
  organization_members
  refresh_tokens
}

Table users {
  id            uuid          [pk, note: 'UUID v7']
  email         varchar(255)  [unique, not null, note: 'RFC 5322, normalized lowercase']
  password_hash varchar(255)  [not null, note: 'bcrypt hash']
  name          varchar(255)  [not null, note: '1-255 chars']
  avatar_url    varchar(512)  [note: 'nullable']
  last_login_at timestamptz   [note: 'nullable']
  created_at    timestamptz   [not null, default: `now()`]
  updated_at    timestamptz   [not null, default: `now()`]
  deleted_at    timestamptz   [note: 'soft delete']

  indexes {
    email [unique, name: 'idx_users_email']
    created_at [name: 'idx_users_created_at']
    (deleted_at) [name: 'idx_users_deleted_at', note: 'partial index WHERE deleted_at IS NULL']
  }
}

Table organizations {
  id         uuid          [pk, note: 'UUID v7']
  name       varchar(255)  [not null]
  slug       varchar(100)  [unique, not null, note: 'URL-friendly identifier']
  logo_url   varchar(512)  [note: 'nullable']
  settings   jsonb         [not null, default: '{}', note: 'org preferences, billing tier, etc.']
  created_at timestamptz   [not null, default: `now()`]
  updated_at timestamptz   [not null, default: `now()`]
  deleted_at timestamptz   [note: 'soft delete']

  indexes {
    slug [unique, name: 'idx_organizations_slug']
  }
}

Table organization_members {
  id              uuid        [pk, note: 'UUID v7']
  organization_id uuid        [not null]
  user_id         uuid        [not null]
  role            user_role   [not null, default: 'member']
  joined_at       timestamptz [not null, default: `now()`]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz [note: 'soft delete']

  indexes {
    (organization_id, user_id) [unique, name: 'idx_org_members_org_user']
    organization_id [name: 'idx_org_members_org_id']
    user_id [name: 'idx_org_members_user_id']
  }
}

Table refresh_tokens {
  id          uuid         [pk, note: 'UUID v7']
  user_id     uuid         [not null]
  token_hash  varchar(128) [unique, not null, note: 'SHA-256 of token']
  device_info varchar(512) [note: 'nullable - user agent, IP']
  expires_at  timestamptz  [not null]
  revoked     boolean      [not null, default: false]
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]
  deleted_at  timestamptz  [note: 'soft delete']

  indexes {
    token_hash [unique, name: 'idx_refresh_tokens_hash']
    user_id [name: 'idx_refresh_tokens_user_id']
    (user_id, revoked) [name: 'idx_refresh_tokens_user_active']
  }
}

// IAM Refs
Ref: organization_members.organization_id > organizations.id
Ref: organization_members.user_id > users.id
Ref: refresh_tokens.user_id > users.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 2: Project Management
// ─────────────────────────────────────────────────────────────────────────────

TableGroup project {
  projects
  project_members
  tags
  project_tags
}

Table projects {
  id               uuid            [pk, note: 'UUID v7']
  organization_id  uuid            [not null]
  created_by       uuid            [not null, note: 'user who created']
  code             varchar(20)     [unique, not null, note: 'OUT-101, OUT-102...']
  name             varchar(255)    [not null]
  description      text            [note: 'nullable']
  status           project_status  [not null, default: 'draft']
  type             project_type    [not null, default: 'greenfield']
  progress_percent integer         [not null, default: 0, note: '0-100']
  created_at       timestamptz     [not null, default: `now()`]
  updated_at       timestamptz     [not null, default: `now()`]
  deleted_at       timestamptz     [note: 'soft delete']

  indexes {
    code [unique, name: 'idx_projects_code']
    (organization_id, status) [name: 'idx_projects_org_status']
    organization_id [name: 'idx_projects_org_id']
    created_by [name: 'idx_projects_created_by']
  }
}

Table project_members {
  id         uuid         [pk, note: 'UUID v7']
  project_id uuid         [not null]
  user_id    uuid         [not null]
  role       varchar(50)  [not null, default: 'developer', note: 'lead/architect/developer/viewer']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz  [note: 'soft delete']

  indexes {
    (project_id, user_id) [unique, name: 'idx_proj_members_proj_user']
    project_id [name: 'idx_proj_members_project_id']
    user_id [name: 'idx_proj_members_user_id']
  }
}

Table tags {
  id              uuid         [pk, note: 'UUID v7']
  organization_id uuid         [not null]
  name            varchar(100) [not null]
  color           varchar(7)   [not null, default: '#6B7280', note: 'hex color']
  category        varchar(50)  [note: 'nullable: tech/maturity/custom']
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]
  deleted_at      timestamptz  [note: 'soft delete']

  indexes {
    (organization_id, name) [unique, name: 'idx_tags_org_name']
    organization_id [name: 'idx_tags_org_id']
  }
}

Table project_tags {
  id         uuid        [pk, note: 'UUID v7']
  project_id uuid        [not null]
  tag_id     uuid        [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, tag_id) [unique, name: 'idx_project_tags_proj_tag']
    project_id [name: 'idx_project_tags_project_id']
    tag_id [name: 'idx_project_tags_tag_id']
  }
}

// Project Refs
Ref: projects.organization_id > organizations.id
Ref: projects.created_by > users.id
Ref: project_members.project_id > projects.id
Ref: project_members.user_id > users.id
Ref: tags.organization_id > organizations.id
Ref: project_tags.project_id > projects.id
Ref: project_tags.tag_id > tags.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 3: Interview & Conversation
// ─────────────────────────────────────────────────────────────────────────────

TableGroup interview {
  interviews
  messages
  interview_notes
}

Table interviews {
  id              uuid              [pk, note: 'UUID v7']
  project_id      uuid              [not null]
  conducted_by    uuid              [not null, note: 'user_id who leads']
  title           varchar(255)      [not null]
  status          interview_status  [not null, default: 'scheduled']
  interview_code  varchar(30)       [unique, not null, note: 'INT-2024-XXX']
  total_messages  integer           [not null, default: 0, note: 'counter cache']
  started_at      timestamptz       [note: 'nullable']
  completed_at    timestamptz       [note: 'nullable']
  created_at      timestamptz       [not null, default: `now()`]
  updated_at      timestamptz       [not null, default: `now()`]
  deleted_at      timestamptz       [note: 'soft delete']

  indexes {
    interview_code [unique, name: 'idx_interviews_code']
    project_id [name: 'idx_interviews_project_id']
    (project_id, status) [name: 'idx_interviews_project_status']
    conducted_by [name: 'idx_interviews_conducted_by']
  }
}

Table messages {
  id           uuid            [pk, note: 'UUID v7']
  interview_id uuid            [not null]
  user_id      uuid            [note: 'nullable - null for AI/system messages']
  sender       message_sender  [not null]
  type         message_type    [not null, default: 'text']
  content      text            [not null]
  metadata     jsonb           [default: '{}', note: 'model version, token count, refs, citations']
  created_at   timestamptz     [not null, default: `now()`]
  updated_at   timestamptz     [not null, default: `now()`]
  deleted_at   timestamptz     [note: 'soft delete']

  indexes {
    (interview_id, created_at) [name: 'idx_messages_interview_time']
    interview_id [name: 'idx_messages_interview_id']
  }
}

Table interview_notes {
  id              uuid        [pk, note: 'UUID v7']
  interview_id    uuid        [unique, not null, note: 'one-to-one with interview']
  last_edited_by  uuid        [not null, note: 'user_id']
  summary         text        [note: 'nullable']
  content         text        [note: 'rich text notes']
  metrics         jsonb       [not null, default: '{"progress": 0, "estimatedHours": "", "budget": ""}', note: 'progress/hours/budget']
  tags_snapshot   jsonb       [not null, default: '[]', note: 'tags at time of note']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz [note: 'soft delete']

  indexes {
    interview_id [unique, name: 'idx_interview_notes_interview_id']
  }
}

// Interview Refs
Ref: interviews.project_id > projects.id
Ref: interviews.conducted_by > users.id
Ref: messages.interview_id > interviews.id
Ref: messages.user_id > users.id
Ref: interview_notes.interview_id > interviews.id
Ref: interview_notes.last_edited_by > users.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 4: SDLC Template Engine
// ─────────────────────────────────────────────────────────────────────────────

TableGroup template {
  sdlc_templates
  template_milestones
  template_epics
  template_issues
  template_checklist_items
}

Table sdlc_templates {
  id               uuid         [pk, note: 'UUID v7']
  version          varchar(20)  [unique, not null, note: 'v4.0, v5.0']
  name             varchar(255) [not null, note: 'Universal Software Project Setup Template']
  description      text         [note: 'nullable']
  is_active        boolean      [not null, default: false, note: 'current default template']
  total_milestones integer      [not null, default: 0]
  total_epics      integer      [not null, default: 0]
  total_issues     integer      [not null, default: 0]
  published_at     timestamptz  [note: 'nullable - when made available']
  created_at       timestamptz  [not null, default: `now()`]
  updated_at       timestamptz  [not null, default: `now()`]
  deleted_at       timestamptz  [note: 'soft delete']

  indexes {
    version [unique, name: 'idx_sdlc_templates_version']
    is_active [name: 'idx_sdlc_templates_active']
  }
}

Table template_milestones {
  id                 uuid         [pk, note: 'UUID v7']
  template_id        uuid         [not null]
  sort_order         integer      [not null, note: '0=Phase0, 1=M1, ... 13=M13']
  code               varchar(20)  [not null, note: 'PHASE-0, M1, M2, ... M13']
  name               varchar(255) [not null, note: 'Governance & Compliance, Discovery & Planning...']
  objective          text         [note: 'milestone goal description']
  applicability_tags jsonb        [not null, default: '[]', note: '["WEB","MOBILE","DATA","AI","K8S","BLOCKCHAIN","COST"]']
  is_required        boolean      [not null, default: true, note: 'mandatory or optional milestone']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]
  deleted_at         timestamptz  [note: 'soft delete']

  indexes {
    (template_id, sort_order) [unique, name: 'idx_milestones_template_order']
    template_id [name: 'idx_milestones_template_id']
  }
}

Table template_epics {
  id                 uuid         [pk, note: 'UUID v7']
  milestone_id       uuid         [not null]
  sort_order         integer      [not null]
  name               varchar(255) [not null, note: 'Regulatory & Compliance Assessment, etc.']
  description        text         [note: 'nullable']
  applicability_tags jsonb        [not null, default: '[]', note: '["ENTERPRISE","STARTUP-MINIMAL"]']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]
  deleted_at         timestamptz  [note: 'soft delete']

  indexes {
    (milestone_id, sort_order) [unique, name: 'idx_epics_milestone_order']
    milestone_id [name: 'idx_epics_milestone_id']
  }
}

Table template_issues {
  id                   uuid         [pk, note: 'UUID v7']
  epic_id              uuid         [not null]
  parent_issue_id      uuid         [note: 'nullable - for sub-issues']
  sort_order           integer      [not null]
  name                 varchar(255) [not null, note: 'Regulatory Requirements Inventory, GDPR Assessment...']
  how_to_fill          text         [note: 'step-by-step instructions']
  description_template text         [note: 'markdown template, copy-paste ready']
  applicability_tags   jsonb        [not null, default: '[]', note: '["ENTERPRISE","STARTUP-MINIMAL","BROWNFIELD"]']
  metadata             jsonb        [not null, default: '{}', note: 'extra config, effort estimate, category']
  depth                integer      [not null, default: 0, note: '0=issue, 1=sub-issue, 2=sub-sub-issue']
  created_at           timestamptz  [not null, default: `now()`]
  updated_at           timestamptz  [not null, default: `now()`]
  deleted_at           timestamptz  [note: 'soft delete']

  indexes {
    (epic_id, sort_order) [name: 'idx_issues_epic_order']
    epic_id [name: 'idx_issues_epic_id']
    parent_issue_id [name: 'idx_issues_parent_id']
  }
}

Table template_checklist_items {
  id          uuid        [pk, note: 'UUID v7']
  issue_id    uuid        [not null]
  sort_order  integer     [not null]
  label       text        [not null, note: 'checklist item text']
  is_critical boolean     [not null, default: false, note: 'blocks progress if not completed']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  deleted_at  timestamptz [note: 'soft delete']

  indexes {
    (issue_id, sort_order) [name: 'idx_checklist_issue_order']
    issue_id [name: 'idx_checklist_issue_id']
  }
}

// Template Refs
Ref: template_milestones.template_id > sdlc_templates.id
Ref: template_epics.milestone_id > template_milestones.id
Ref: template_issues.epic_id > template_epics.id
Ref: template_issues.parent_issue_id > template_issues.id
Ref: template_checklist_items.issue_id > template_issues.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 5: Estimation Engine
// ─────────────────────────────────────────────────────────────────────────────

TableGroup estimation {
  estimation_sessions
  estimation_milestone_statuses
  estimation_responses
  estimation_checklist_results
  estimation_outputs
}

Table estimation_sessions {
  id               uuid                      [pk, note: 'UUID v7']
  project_id       uuid                      [not null]
  template_id      uuid                      [not null, note: 'pinned template version']
  started_by       uuid                      [not null, note: 'user_id']
  status           estimation_session_status  [not null, default: 'draft']
  overall_progress integer                   [not null, default: 0, note: '0-100']
  config           jsonb                     [not null, default: '{}', note: 'selected tags, project type, variant']
  started_at       timestamptz               [note: 'nullable']
  completed_at     timestamptz               [note: 'nullable']
  created_at       timestamptz               [not null, default: `now()`]
  updated_at       timestamptz               [not null, default: `now()`]
  deleted_at       timestamptz               [note: 'soft delete']

  indexes {
    (project_id, template_id) [name: 'idx_est_sessions_project_template']
    project_id [name: 'idx_est_sessions_project_id']
    started_by [name: 'idx_est_sessions_started_by']
    (status) [name: 'idx_est_sessions_status']
  }
}

Table estimation_milestone_statuses {
  id               uuid                       [pk, note: 'UUID v7']
  session_id       uuid                       [not null]
  milestone_id     uuid                       [not null, note: 'ref to template_milestones']
  status           milestone_tracking_status   [not null, default: 'pending']
  skip_reason      text                       [note: 'nullable - why the user skipped this']
  reviewer_verdict reviewer_verdict            [note: 'nullable - AI/user verdict on skip']
  reviewed_by      uuid                       [note: 'nullable - user_id or null for AI']
  progress_percent integer                    [not null, default: 0, note: '0-100']
  started_at       timestamptz                [note: 'nullable']
  completed_at     timestamptz                [note: 'nullable']
  created_at       timestamptz                [not null, default: `now()`]
  updated_at       timestamptz                [not null, default: `now()`]
  deleted_at       timestamptz                [note: 'soft delete']

  indexes {
    (session_id, milestone_id) [unique, name: 'idx_milestone_status_session_milestone']
    session_id [name: 'idx_milestone_status_session_id']
    (session_id, status) [name: 'idx_milestone_status_session_status']
  }
}

Table estimation_responses {
  id              uuid        [pk, note: 'UUID v7']
  session_id      uuid        [not null]
  issue_id        uuid        [not null, note: 'ref to template_issues']
  answered_by     uuid        [not null, note: 'user_id']
  answer          text        [not null, note: 'user response text']
  structured_data jsonb       [note: 'nullable - parsed/structured version of answer']
  is_complete     boolean     [not null, default: false, note: 'all required fields filled']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz [note: 'soft delete']

  indexes {
    (session_id, issue_id) [unique, name: 'idx_responses_session_issue']
    session_id [name: 'idx_responses_session_id']
  }
}

Table estimation_checklist_results {
  id                uuid        [pk, note: 'UUID v7']
  session_id        uuid        [not null]
  checklist_item_id uuid        [not null, note: 'ref to template_checklist_items']
  is_checked        boolean     [not null, default: false]
  note              text        [note: 'nullable - user comment']
  checked_by        uuid        [not null, note: 'user_id']
  checked_at        timestamptz [note: 'nullable']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  deleted_at        timestamptz [note: 'soft delete']

  indexes {
    (session_id, checklist_item_id) [unique, name: 'idx_checklist_results_session_item']
    session_id [name: 'idx_checklist_results_session_id']
  }
}

Table estimation_outputs {
  id                     uuid        [pk, note: 'UUID v7']
  session_id             uuid        [not null]
  output_type            varchar(50) [not null, default: 'summary', note: 'summary/detailed/executive']
  result                 jsonb       [not null, default: '{}', note: 'full estimation result']
  architecture_decisions jsonb       [not null, default: '{}', note: 'tech stack, patterns, recommendations']
  compliance_summary     jsonb       [not null, default: '{}', note: 'regulatory checklist results']
  confidence_score       integer     [note: 'nullable, 0-100']
  estimated_hours_min    integer     [note: 'nullable']
  estimated_hours_max    integer     [note: 'nullable']
  estimated_budget_min   integer     [note: 'nullable, in cents']
  estimated_budget_max   integer     [note: 'nullable, in cents']
  currency               varchar(3)  [not null, default: 'BRL', note: 'ISO 4217']
  generated_at           timestamptz [not null, default: `now()`]
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]
  deleted_at             timestamptz [note: 'soft delete']

  indexes {
    session_id [name: 'idx_outputs_session_id']
    (session_id, output_type) [name: 'idx_outputs_session_type']
  }
}

// Estimation Refs
Ref: estimation_sessions.project_id > projects.id
Ref: estimation_sessions.template_id > sdlc_templates.id
Ref: estimation_sessions.started_by > users.id
Ref: estimation_milestone_statuses.session_id > estimation_sessions.id
Ref: estimation_milestone_statuses.milestone_id > template_milestones.id
Ref: estimation_milestone_statuses.reviewed_by > users.id
Ref: estimation_responses.session_id > estimation_sessions.id
Ref: estimation_responses.issue_id > template_issues.id
Ref: estimation_responses.answered_by > users.id
Ref: estimation_checklist_results.session_id > estimation_sessions.id
Ref: estimation_checklist_results.checklist_item_id > template_checklist_items.id
Ref: estimation_checklist_results.checked_by > users.id
Ref: estimation_outputs.session_id > estimation_sessions.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 6: Integrations
// ─────────────────────────────────────────────────────────────────────────────

TableGroup integration {
  integration_connections
  export_sessions
  export_mappings
}

Table integration_connections {
  id                  uuid                  [pk, note: 'UUID v7']
  organization_id     uuid                  [not null]
  created_by          uuid                  [not null, note: 'user_id']
  provider            integration_provider  [not null]
  name                varchar(255)          [not null, note: 'My Linear Workspace']
  credentials_encrypted jsonb               [not null, default: '{}', note: 'encrypted API keys, OAuth tokens']
  config              jsonb                 [not null, default: '{}', note: 'workspace IDs, project keys, team mappings']
  is_active           boolean               [not null, default: true]
  last_synced_at      timestamptz           [note: 'nullable']
  created_at          timestamptz           [not null, default: `now()`]
  updated_at          timestamptz           [not null, default: `now()`]
  deleted_at          timestamptz           [note: 'soft delete']

  indexes {
    (organization_id, provider) [name: 'idx_integrations_org_provider']
    organization_id [name: 'idx_integrations_org_id']
  }
}

Table export_sessions {
  id                        uuid          [pk, note: 'UUID v7']
  estimation_session_id     uuid          [not null]
  integration_connection_id uuid          [not null]
  triggered_by              uuid          [not null, note: 'user_id']
  status                    export_status [not null, default: 'pending']
  items_total               integer       [not null, default: 0]
  items_exported            integer       [not null, default: 0]
  error_log                 jsonb         [note: 'nullable - failure details']
  export_config             jsonb         [not null, default: '{}', note: 'what to export, mapping rules']
  started_at                timestamptz   [note: 'nullable']
  completed_at              timestamptz   [note: 'nullable']
  created_at                timestamptz   [not null, default: `now()`]
  updated_at                timestamptz   [not null, default: `now()`]
  deleted_at                timestamptz   [note: 'soft delete']

  indexes {
    estimation_session_id [name: 'idx_export_sessions_est_session']
    integration_connection_id [name: 'idx_export_sessions_integration']
    triggered_by [name: 'idx_export_sessions_triggered_by']
    (status) [name: 'idx_export_sessions_status']
  }
}

Table export_mappings {
  id                   uuid         [pk, note: 'UUID v7']
  export_session_id    uuid         [not null]
  internal_entity_type varchar(50)  [not null, note: 'milestone/epic/issue/checklist']
  internal_entity_id   uuid         [not null, note: 'ref to template entity']
  external_entity_type varchar(50)  [not null, note: 'project/epic/issue/task/story']
  external_entity_id   varchar(255) [not null, note: 'Linear/Jira/Asana/GitHub ID']
  external_url         varchar(512) [note: 'nullable - link to external tool']
  sync_metadata        jsonb        [not null, default: '{}', note: 'last sync state, version']
  last_synced_at       timestamptz  [not null, default: `now()`]
  created_at           timestamptz  [not null, default: `now()`]
  updated_at           timestamptz  [not null, default: `now()`]
  deleted_at           timestamptz  [note: 'soft delete']

  indexes {
    export_session_id [name: 'idx_export_mappings_session']
    (export_session_id, internal_entity_type, internal_entity_id) [name: 'idx_export_mappings_internal']
    (external_entity_type, external_entity_id) [name: 'idx_export_mappings_external']
  }
}

// Integration Refs
Ref: integration_connections.organization_id > organizations.id
Ref: integration_connections.created_by > users.id
Ref: export_sessions.estimation_session_id > estimation_sessions.id
Ref: export_sessions.integration_connection_id > integration_connections.id
Ref: export_sessions.triggered_by > users.id
Ref: export_mappings.export_session_id > export_sessions.id

// ─────────────────────────────────────────────────────────────────────────────
// BOUNDED CONTEXT 7: Audit
// ─────────────────────────────────────────────────────────────────────────────

TableGroup audit {
  audit_log
}

Table audit_log {
  id              uuid         [pk, note: 'UUID v7']
  organization_id uuid         [note: 'nullable - system-level events have no org']
  user_id         uuid         [note: 'nullable - system-triggered events']
  entity_type     varchar(50)  [not null, note: 'user/project/interview/estimation/export']
  entity_id       uuid         [not null, note: 'affected entity ID']
  action          varchar(50)  [not null, note: 'create/update/delete/export/login/logout']
  old_values      jsonb        [note: 'nullable - state before change']
  new_values      jsonb        [note: 'nullable - state after change']
  ip_address      varchar(45)  [note: 'nullable - IPv4/IPv6']
  user_agent      varchar(512) [note: 'nullable']
  created_at      timestamptz  [not null, default: `now()`, note: 'IMMUTABLE - no update/delete']

  indexes {
    (entity_type, entity_id) [name: 'idx_audit_entity']
    (organization_id, created_at) [name: 'idx_audit_org_time']
    user_id [name: 'idx_audit_user_id']
    created_at [name: 'idx_audit_created_at']
  }

  Note: 'Append-only table. No UPDATE or DELETE allowed. No deleted_at column.'
}

// Audit Refs (soft - no FK constraint to allow referencing deleted entities)
// Ref: audit_log.organization_id > organizations.id  -- intentionally no FK
// Ref: audit_log.user_id > users.id                  -- intentionally no FK
