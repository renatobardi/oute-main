# OUTE Develop Routing
# Caddy escuta na porta 80 (interna), publicada como 8888 no host pelo docker-compose.develop.yml
# Acesso: http://34.132.93.171:8888/
# Bases SvelteKit: /auth /dashboard /projects /chat (99_home = root)

:80 {
  # /_app/* — assets SvelteKit com cascade por 404
  # Cada serviço tem hashes únicos; tenta cada um até encontrar o arquivo
  @app_assets path /_app/*
  handle @app_assets {
    @err404 status 4xx
    reverse_proxy oute-dev-home:3003 {
      handle_response @err404 {
        reverse_proxy oute-dev-auth:3001 {
          handle_response @err404 {
            reverse_proxy oute-dev-dashboard:3000 {
              handle_response @err404 {
                reverse_proxy oute-dev-interview:3002
              }
            }
          }
        }
      }
    }
  }

  # Auth — base: /auth (login, profile, api/auth, api/session...)
  @auth path /auth*
  handle @auth {
    reverse_proxy oute-dev-auth:3001 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.proto}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Dashboard — base: /dashboard
  @dashboard path /dashboard*
  handle @dashboard {
    reverse_proxy oute-dev-dashboard:3000 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.proto}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Projects — base: /projects
  @projects path /projects*
  handle @projects {
    reverse_proxy oute-dev-projects:3002 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.proto}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Chat — base: /chat
  @chat path /chat*
  handle @chat {
    reverse_proxy oute-dev-interview:3002 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.proto}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Fallback: 99_home — root sem base
  handle {
    reverse_proxy oute-dev-home:3003 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto {http.request.proto}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  log {
    output stdout
    format json
  }
}
